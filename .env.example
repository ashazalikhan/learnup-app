# ── Supabase ──────────────────────────────────────────────────
# Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# CLI only (npm run db:link / db:push) — Dashboard → Account → Access Tokens
# Or run: npx supabase login
# SUPABASE_ACCESS_TOKEN=your-personal-access-token

# Database password when linking (Dashboard → Settings → Database)
# SUPABASE_DB_PASSWORD=your-database-password

# After linking, apply migrations: npm run db:push

# ── Code Execution API (Piston) ──────────────────────────────
# Free public API — no key needed. Override if self-hosting.
NEXT_PUBLIC_PISTON_API_URL=https://emkc.org/api/v2/piston
