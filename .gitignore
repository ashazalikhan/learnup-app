# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── Dependencies ──────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Testing ───────────────────────────────────────────────────
/coverage

# ── Next.js ───────────────────────────────────────────────────
/.next/
/out/

# ── Production ────────────────────────────────────────────────
/build
/dist

# ── Environment / Secrets ─────────────────────────────────────
# NEVER commit secrets. Use .env.example for templates.
.env
.env.*
!.env.example

# ── OS Generated ──────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ── IDE / Editor ──────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Debug Logs ────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Certificates ──────────────────────────────────────────────
*.pem

# ── Vercel ────────────────────────────────────────────────────
.vercel

# ── TypeScript ────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Supabase local ────────────────────────────────────────────
.supabase/
supabase/.temp/
